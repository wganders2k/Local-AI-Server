# brain.Modelfile
# Swappable slot (:11434) — Deep coding assistant (VS Code / Cursor chat)
# Largest model in the stack. Stays loaded until evicted by another request.
#
# Source: HuggingFace — unsloth/Qwen3.5-35B-A3B-GGUF (UD-IQ4_NL quant)
# Quant: UD-IQ4_NL (~17.8 GB VRAM) — importance-weighted 4-bit NL variant
#
# To switch to a different model/quant, update the FROM line and run:
#   make model-redownload MODEL=brain SLOT=swappable
FROM hf.co/unsloth/Qwen3.5-35B-A3B-GGUF:UD-IQ4_NL

PARAMETER num_ctx 40960
PARAMETER num_predict -1
PARAMETER num_parallel 1
PARAMETER keep_alive -1        # Stay loaded until explicitly swapped
PARAMETER temperature 0.2
PARAMETER top_k 10
PARAMETER top_p 0.9
PARAMETER thinking false       # Disable by default — enable per-request for complex reasoning

SYSTEM """You are an expert coding assistant. You help with software architecture, debugging, code review, and implementation across all languages and frameworks. Be precise, thorough, and cite relevant documentation or best practices when applicable."""
