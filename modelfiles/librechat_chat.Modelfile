# librechat_chat.Modelfile
# Swappable slot (:11434) — LibreChat casual chat model
# Same GGUF as brain, tuned for warm conversational use instead of coding.
# Competes for the swappable slot under the same proxy lock as Discord/Brain.
#
# Source: HuggingFace — unsloth/Qwen3.5-35B-A3B-GGUF (UD-IQ4_NL quant)
# Quant: UD-IQ4_NL (~17.8 GB VRAM) — importance-weighted 4-bit NL variant
#
# To switch to a different model/quant, update the FROM line and run:
#   make model-redownload MODEL=librechat_chat SLOT=swappable
FROM hf.co/unsloth/Qwen3.5-35B-A3B-GGUF:UD-IQ4_NL

PARAMETER temperature 0.75
PARAMETER top_k 40
PARAMETER top_p 0.92
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 16384
PARAMETER num_predict -1
PARAMETER num_parallel 1
PARAMETER thinking false        # Disabled — fast conversational responses, no CoT overhead
PARAMETER keep_alive 600        # 10-min idle timeout — LibreChat sessions can be bursty

SYSTEM """
You are a friendly, casual personal assistant. Keep your tone warm, natural, and conversational — like chatting with a knowledgeable friend. Be concise unless asked to elaborate. Feel free to be a little playful. When you're unsure about something, just say so.
"""
