# ============================================================
# Local AI Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# Variables marked REQUIRED have no default in docker-compose.yml —
# leaving them blank starts the affected service misconfigured.
# ============================================================


# ------------------------------------------------------------
# Discord Bot
# ------------------------------------------------------------
# REQUIRED. Bot token from the Discord Developer Portal:
#   https://discord.com/developers/applications → Your App → Bot → Token
# The history service uses this same token.
#
# The bot also needs both PRIVILEGED intents enabled in the portal:
#   MESSAGE CONTENT  — reading messages inside /chat threads
#   SERVER MEMBERS   — display-name resolution
# Without them the bot will not start.
DISCORD_TOKEN=

# REQUIRED. Compose passes this through with no fallback, so an unset value
# reaches the bot as an empty string and fails validation at startup.
PROXY_URL=http://proxy:11436

# Max queued proxy requests before the bot returns an ephemeral error
MAX_QUEUE_DEPTH=3

# Max requests per user per minute.
# Applies to /mimic and /chat. Deliberately NOT applied to /lore, which is a
# multi-round research task that a per-minute window cannot sensibly bound.
RATE_LIMIT_PER_USER=5

# Server-specific background for the /lore agent (member alias index, persona
# notes). Never committed because it holds real names, and NOT in prompts/ —
# that directory is committed prompt templates baked into the image. This lives
# on the bot_context volume beside the session store:
#   cp discord-bot/prompts/lore_context.example.md \
#      /mnt/storage/array/DiscordArchive/bot_context/lore/context.md
# If missing, the bot still starts and /lore still answers, minus the alias index.
LORE_CONTEXT_PATH=bot_context/lore/context.md


# ------------------------------------------------------------
# Model Storage
# ------------------------------------------------------------
# Host directory holding GGUF files: $MODELS_DIR/<publisher>/<model>/file.gguf
# Bind-mounted read-only into both llama-server containers, so `make nuke`
# never deletes model weights.
# Download everything with: make models-download
MODELS_DIR=/srv/models

# HuggingFace token — only needed for private or gated repos.
# All default models are public. Also passed to Open WebUI.
HF_TOKEN=


# ------------------------------------------------------------
# Autocomplete Model (permanent slot, :11435)
# ------------------------------------------------------------
# The permanent slot sits behind the `autocomplete` compose profile, so a plain
# `make up` does NOT start it regardless of this value. Use the make targets:
#   make enable-autocomplete   → starts llama-permanent and sets this true
#   make disable-autocomplete  → stops it and sets this false
#
# This flag controls the proxy's behaviour: when false, requests for the
# "autocomplete" alias get a 503 instead of being forwarded to a dead container.
AUTOCOMPLETE_ENABLED=true


# ------------------------------------------------------------
# GPU Idle Eviction (proxy)
# ------------------------------------------------------------
# llama-server keeps a model resident once loaded and never frees VRAM between
# requests, so without this a background GPU job would never get a window.
# After this many seconds with no LLM request, the proxy unloads the resident
# model and verifies the unload actually happened.
#
# This is the single biggest factor in whether a submitted training run ever
# gets the card: any LLM request restarts the clock.
IDLE_EVICT_ENABLED=true
IDLE_EVICT_SECONDS=600


# ------------------------------------------------------------
# Open WebUI
# ------------------------------------------------------------
# Anthropic API key for the Claude backend. Leave blank to disable it — the
# local llama-server backend is always available regardless.
ANTHROPIC_API_KEY=

# REQUIRED if Open WebUI is exposed. OIDC client credentials from authentik.
# New accounts land inactive (DEFAULT_USER_ROLE=pending) and need an admin to
# promote them, so this is a gate on top of whoever authentik lets sign in.
OPENWEBUI_CLIENT_ID=
OPENWEBUI_CLIENT_SECRET=


# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------
# REQUIRED. Break-glass local admin password, used when authentik is down.
# Do not set this to "admin" — this host is reachable from the internet.
GRAFANA_ADMIN_PASSWORD=

# REQUIRED if Grafana is exposed. OIDC client credentials from authentik.
# Membership of the authentik group "grafana-admins" grants Admin;
# everyone else who can reach the app gets Viewer.
GRAFANA_CLIENT_ID=
GRAFANA_CLIENT_SECRET=


# ------------------------------------------------------------
# RAG / Lore
# ------------------------------------------------------------
# Set false to disable retrieval for maintenance. /lore still runs but the
# agent's tools return nothing.
RAG_ENABLED=true


# ------------------------------------------------------------
# History Service
# ------------------------------------------------------------
# REQUIRED for history collection. Right-click the server icon → Copy Server ID
# (needs Developer Mode enabled in Discord settings).
DISCORD_GUILD_ID=

# Comma-separated channel IDs never to export.
#
# CAVEAT: history-service/config.py reads this, but docker-compose.yml does not
# currently pass it into the container — so setting it here has no effect until
# `- EXCLUDED_CHANNELS=${EXCLUDED_CHANNELS:-}` is added to the history-service
# service definition.
EXCLUDED_CHANNELS=


# ------------------------------------------------------------
# Image Captioning (history service)
# ------------------------------------------------------------
# Describes Discord image attachments so their content is searchable via /lore.
#
# This is a GPU consumer (~18 GB in the swappable slot), which is why it is
# windowed. Enabling it is NOT sufficient on its own: the [image-caption]
# preset is currently commented out in models.ini and must be uncommented, and
# the GGUF downloaded, or every caption request fails.
IMAGE_CAPTION_ENABLED=false

# Model alias for captioning — must match an alias in models.ini
IMAGE_CAPTION_MODEL=image-caption

# Images processed per run
IMAGE_CAPTION_BATCH_SIZE=10

# Hour window during which captioning may run. These are UTC hours, not local.
IMAGE_CAPTION_WINDOW_START=3
IMAGE_CAPTION_WINDOW_END=6

# Skip images larger than this, to avoid downloading huge files
IMAGE_CAPTION_MAX_FILE_SIZE_MB=10


# ------------------------------------------------------------
# LoRA Training
# ------------------------------------------------------------
# Which config the trainer runs. The Makefile sets this from CONFIG=, so there
# is normally no reason to set it here:
#   make train-submit CONFIG=configs/smoke.yaml
#
# The trainer is behind the `managed` profile and never starts on `make up`.
TRAIN_CONFIG=configs/smoke.yaml


# ------------------------------------------------------------
# Running services outside Compose
# ------------------------------------------------------------
# Inside Compose these are set directly in docker-compose.yml and values here
# are ignored. They matter only if you run the proxy on the host.
LLAMA_PERMANENT=http://llama-permanent:8080
LLAMA_SWAPPABLE=http://llama-swappable:8080
