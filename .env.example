# ============================================================
# Local AI Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# ============================================================

# ------------------------------------------------------------
# Discord Bot
# ------------------------------------------------------------
# Bot token from Discord Developer Portal
# https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your_discord_bot_token_here

# ------------------------------------------------------------
# Anthropic API (LibreChat Claude backend)
# ------------------------------------------------------------
# Leave blank to disable the Claude backend in LibreChat.
# When set, LibreChat will offer Claude as a model option.
# The local llama-server backend is always available regardless.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Model Storage
# ------------------------------------------------------------
# Host directory where GGUF model files are stored.
# Structure: $MODELS_DIR/<publisher>/<model>/filename.gguf
# Download all models with: make models-download
# Default: /srv/models 
MODELS_DIR=/srv/models

# HuggingFace token — required for private or gated repos.
# Leave blank for public repos (all default models are public).
HF_TOKEN=

# ------------------------------------------------------------
# Internal service URLs (defaults work with Docker Compose)
# ------------------------------------------------------------
# These are used inside the Docker network — don't change
# unless you're running services outside of Compose.
LLAMA_PERMANENT=http://llama-permanent:8080
LLAMA_SWAPPABLE=http://llama-swappable:8080

# ------------------------------------------------------------
# Discord Bot tuning (optional — defaults shown)
# ------------------------------------------------------------
BOT_PREFIX=mimic_
MAX_QUEUE_DEPTH=3
RATE_LIMIT_PER_USER=5
TYPING_INDICATOR_INTERVAL=5
LORE_TOP_K=5

# ------------------------------------------------------------
# ChromaDB (RAG service)
# ------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ------------------------------------------------------------
# History Service
# ------------------------------------------------------------
# Discord server (guild) ID — right-click server icon → Copy Server ID
# (requires Developer Mode enabled in Discord settings)
DISCORD_GUILD_ID=your_discord_guild_id_here

# Number of new clean messages per user before triggering LoRA retraining
# "Clean" = passes filtering rules (min 5 words, no bot commands, no pure emoji, etc.)
RETRAIN_THRESHOLD=200

# How often to pull new messages from recently active channels (minutes)
INCREMENTAL_PULL_INTERVAL=15

# Cron expression for full history rebuild (default: monthly at 3 AM)
FULL_PULL_CRON="0 3 1 * *"

# Hour window during which training jobs may run (24h format)
# Training is only dispatched during this window to avoid inference contention
TRAINING_WINDOW_START=3
TRAINING_WINDOW_END=6

# Set to true in Phase 3 when lora-training scripts are ready
# Leave false in Phase 2 (history collection only, no training)
TRAINING_TRIGGER_ENABLED=false

# ------------------------------------------------------------
# Image Captioning (history-service)
# ------------------------------------------------------------
# Enable background image captioning for Discord attachments.
# Captions are stored in JSONL records for RAG ingestion but are
# excluded from LoRA training (synthetic text, not the user's voice).
# Requires the image-caption model to be present in MODELS_DIR.
IMAGE_CAPTION_ENABLED=false

# Model alias used for captioning (must match alias in models.ini)
IMAGE_CAPTION_MODEL=image-caption

# Number of images processed per captioning run (batched to avoid monopolising the slot)
IMAGE_CAPTION_BATCH_SIZE=10

# Hour window during which captioning may run (24h format)
# Shares the training window by default — runs before training dispatch
IMAGE_CAPTION_WINDOW_START=3
IMAGE_CAPTION_WINDOW_END=6

# Skip images larger than this size in megabytes (avoids downloading huge files)
IMAGE_CAPTION_MAX_FILE_SIZE_MB=10
