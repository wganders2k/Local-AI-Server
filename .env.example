# ============================================================
# Local AI Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# ============================================================

# ------------------------------------------------------------
# Discord Bot
# ------------------------------------------------------------
# Bot token from Discord Developer Portal
# https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your_discord_bot_token_here

# ------------------------------------------------------------
# Anthropic API (LibreChat Claude backend)
# ------------------------------------------------------------
# Leave blank to disable the Claude backend in LibreChat.
# When set, LibreChat will offer Claude as a model option.
# The local Ollama backend is always available regardless.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Internal service URLs (defaults work with Docker Compose)
# ------------------------------------------------------------
# These are used inside the Docker network — don't change
# unless you're running services outside of Compose.
OLLAMA_PROXY=http://proxy:11436
OLLAMA_PERMANENT=http://ollama-permanent:11434
OLLAMA_SWAPPABLE=http://ollama-swappable:11434

# ------------------------------------------------------------
# Discord Bot tuning (optional — defaults shown)
# ------------------------------------------------------------
BOT_PREFIX=deepleffen_
MAX_QUEUE_DEPTH=3
RATE_LIMIT_PER_USER=5
TYPING_INDICATOR_INTERVAL=5
LORE_TOP_K=5

# ------------------------------------------------------------
# ChromaDB (RAG service)
# ------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
