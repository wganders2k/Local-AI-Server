[Unit]
# Brings the compose stack up at boot, recreating containers if a normal start
# fails.
#
# Two distinct failure modes produce the identical symptom — a GPU container
# refusing to start with:
#
#   failed to fulfil mount request: open .../libEGL_nvidia.so.<version>: no such file
#
# 1. A driver upgrade (unattended-upgrades does this happily) replaces the
#    versioned userspace libraries a container's OCI mount spec was baked
#    against at *create* time. `restart: unless-stopped` cannot rescue this —
#    restart policies apply to container exits, not failures during init — so
#    the container just stays down until recreated. Recreating regenerates the
#    mount spec against whichever driver is currently installed, which is why
#    ExecStart below falls back to --force-recreate rather than just retrying.
#
# 2. A boot-time RACE, found 2026-08-16 after the stack silently stayed down
#    across three separate reboots (2026-08-10, -11, -13): the toolkit's own
#    nvidia-cdi-refresh.service regenerates /var/run/cdi/nvidia.yaml — the
#    correct, current-driver CDI spec — asynchronously, triggered by a .path
#    unit watching kernel module files as they load during boot. If GPU
#    containers start before that regeneration finishes, CDI resolution falls
#    through to whatever static spec sits in /etc/cdi/nvidia.yaml, which on
#    this box is a stale one-time-generated file nothing keeps in sync. Unlike
#    failure mode 1, --force-recreate does NOT fix this — recreating a
#    container doesn't regenerate a host-level CDI spec, so both the initial
#    attempt and its recreate-on-failure fallback lost the same race and both
#    failed, identically, every time. Closed by ordering after the refresh unit
#    below so it has always finished before this one starts.
Description=local-ai-server compose stack
Requires=docker.service
After=docker.service network-online.target nvidia-cdi-refresh.service
Wants=network-online.target nvidia-cdi-refresh.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=peacow
Group=docker
WorkingDirectory=/home/peacow/local-ai-server

# Try a normal start first — cheap and preserves containers. If anything fails
# to come up (the driver-upgrade case above), recreate. Recreating these
# containers is safe: all persistent data lives in named volumes or bind mounts.
ExecStart=/bin/bash -c '/usr/bin/docker compose up -d --remove-orphans || /usr/bin/docker compose up -d --force-recreate'

ExecStop=/usr/bin/docker compose stop

# Pulling images and loading a model can take a while on a cold boot.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
